<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- سرویس پیش‌زمینه تا اندروید تونل را وسط کار نکشد -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- اعلان همیشگی و کلید قطع و وصل در نوار وضعیت، از اندروید ۱۳ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".AzadApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Azad">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            سرویس VPN مسیر Xray. سرویس مسیر WARP را خود کتابخانه WireGuard
            در مانیفست خودش اعلام کرده و هنگام ادغام اضافه می‌شود.
        -->
        <!--
            نوع specialUse از اندروید ۱۴ برای هر سرویس پیش‌زمینه اجباری است.
            اگر نوع اعلام نشود، startForeground استثنا می‌اندازد و چون سرویس
            با startForegroundService شروع شده، اندروید چند ثانیه بعد کل
            برنامه را می‌کشد.
        -->
        <service
            android:name=".vpn.AzadVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="vpn" />
        </service>

        <!-- دکمه قطع و وصل در اعلان -->
        <receiver
            android:name=".vpn.AzadControl"
            android:exported="false" />

        <!-- کاشی آزاد در پنل تنظیمات سریع، کنار وای‌فای و بلوتوث -->
        <service
            android:name=".vpn.AzadTile"
            android:exported="true"
            android:icon="@drawable/ic_tunnel"
            android:label="@string/tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
